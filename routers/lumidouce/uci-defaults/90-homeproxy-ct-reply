#!/bin/sh

# HomeProxy marks router-originated packets whose destination is outside a
# static reserved-address set. Replies to redirected connections (e.g. DNS
# hijacked to dnsmasq) towards LAN hosts with delegated GUA prefixes get
# marked and policy-routed into lo/TUN instead of back to the client.
# Skip reply-direction packets so only router-initiated flows are proxied.

template=/etc/homeproxy/scripts/firewall_post.ut

[ -f "$template" ] || exit 0
grep -q 'ct direction reply' "$template" && exit 0

sed -i '/^chain homeproxy_mangle_\(output\|tun\) {$/a\
	ct direction reply counter return
' "$template"

[ "$(grep -c 'ct direction reply' "$template")" = 2 ] ||
	logger -t uci-defaults "homeproxy: firewall_post.ut layout changed, ct reply patch incomplete"

exit 0
